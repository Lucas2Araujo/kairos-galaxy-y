<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootHymnal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="fill_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:padding="0dp"
            android:text="@string/btn_back"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/title_hymnal"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="fill_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="5dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btnTabNew"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:text="@string/tab_hymn_new"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabOld"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:text="@string/tab_hymn_old"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabFavs"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.85"
            android:padding="0dp"
            android:text="@string/tab_hymn_favs"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/editHymnSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_hymn_search"
            android:imeOptions="actionGo"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGoHymn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:minWidth="46dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/btn_go"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEmptyHymns"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/no_favorites"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listHymns"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fastScrollEnabled="true" />

</LinearLayout>
