<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootBible"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="fill_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:padding="0dp"
            android:text="@string/btn_back"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/title_bible"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFontDown"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:layout_marginRight="4dp"
            android:padding="0dp"
            android:text="@string/btn_font_down"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFontUp"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:padding="0dp"
            android:text="@string/btn_font_up"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="fill_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="5dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnPrevChapter"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:padding="0dp"
            android:text="@string/btn_prev_chapter"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickReference"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:text="@string/title_bible"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNextChapter"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:padding="0dp"
            android:text="@string/btn_next_chapter"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollBible"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txtBibleChapter"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="16dp"
            android:textSize="16sp" />
    </ScrollView>

</LinearLayout>
